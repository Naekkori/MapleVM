@Component
script CPUCore extends Component
	--[[
	Maple VM 8086 Vitual Machine Engine
	]]
	property number ProcessorSpeed = 5000
	property Entity BIOS_Entity = "d98c8307-fdd4-4052-ad76-d4bb6da31f72"
	
	property Entity VGA = "6f033c67-5e1a-4e95-a098-72f48567f671"
	
	property Entity Speaker = "d8caf485-fd82-4753-8c1b-179114e47f20"
	
	property Entity FDD = "1aefcf35-06e9-4c3d-88ee-c3cac4cd955f"
	
	property Entity PIC = "7d2c4238-f157-4a0b-a903-04e6e3a6c565"
	
	property Entity FPU = "9fe21404-7039-4535-b81d-b35cec3f0307"
	
	property Entity LoadingText = "79afdc7a-b90e-4a45-9f76-731b9ca74b12"
	
	property table Memory = {}
	
	property any Reg = {}
	
	property string State = "STOP"
	property boolean CpuInitReady = false
	property boolean LastCompareResult = false
	
	property any segmentOverride = nil
	property Entity PowerLED = "d83be435-5ade-430e-8fff-e68755cbac74"
	
	property number lastKeycode = 0
	
	property number TimerAccumulator = 0
	
	property table KeyMap = {}
	
	property string lastDebugState = ""
	
	@ExecSpace("ClientOnly")
	method void OnInitialize()
		-- 1. 레지스터 초기화
		self.Reg = {
			AX = 0, BX = 0, CX = 0, DX = 0,
			SP = 0xFFFE, BP = 0, SI = 0, DI = 0,
			CS = 0xF000, DS = 0, ES = 0, SS = 0,
			IP = 0xFFF0,
			Flags = 0x0200
		}
		log("CPU: Registers Initialized.")
		
		-- 2. KeyMap 테이블 초기화
		self.KeyMap = {}
		
		-- 3. 알파벳 매핑 (A-Z) -> 소문자 ASCII (97-122)
		local alphabets = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
		for i = 1, #alphabets do
			local char = alphabets:sub(i, i)
			local keyEnum = KeyboardKey[char]
			if keyEnum then
				-- keyEnum 값(숫자)을 그대로 인덱스로 사용
				self.KeyMap[keyEnum] = 96 + i
			end
		end
		
		-- 4. 숫자 키 매핑 (D0-D9 및 NumPad) -> ASCII (48-57)
		for i = 0, 9 do
			local dKey = KeyboardKey["D" .. i]
			local nKey = KeyboardKey["NumPad" .. i]
			if dKey then self.KeyMap[dKey] = 48 + i end
			if nKey then self.KeyMap[nKey] = 48 + i end
		end
		
		-- 5. 특수 문자 및 제어 키
		local specialKeys = {
			["Return"] = 13,
			["Space"] = 32,
			["Backspace"] = 8,
			["Escape"] = 27,
			["Comma"] = 44,
			["Period"] = 46,
			["Slash"] = 47,
			["Semicolon"] = 59,
			["Minus"] = 45,
			["Equals"] = 61,
			["LeftBracket"] = 91,
			["RightBracket"] = 93,
			["Backslash"] = 92,
			-- ["Grave"] = 96 메월드에서 작동안함
		}
		
		for keyName, ascii in pairs(specialKeys) do
			local keyEnum = KeyboardKey[keyName]
			
			if keyEnum ~= nil then
				self.KeyMap[keyEnum] = ascii
			else
				log_warning("Warning: KeyboardKey." .. keyName .. " is not found in this engine version.")
			end
		end
		
		self.State = "RUNNING"
		self.CpuInitReady = true
		if self.PowerLED then
			self.PowerLED.SpriteGUIRendererComponent.Color = Color.red
		end
		
		log("CPU: Keyboard Mapping Initialized.")
	end
	
	method number ReadByte(number addr)
		-- 20비트 물리 주소 제한
		addr = (addr or 0) & 0xFFFFF
		-- 물리 주소 0xF0000 ~ 0xFFFFF 영역을 BIOS ROM으로 매핑
		if addr >= 0xF0000 then
			local romOffset = addr - 0xF0000
			return self.BIOS_Entity.MapleVMBIOS:ReadROM(romOffset) or 0
		end
		return self.Memory[addr] or 0
	end
	
	method void WriteByte(number addr, number value)
		addr = (addr or 0) & 0xFFFFF
		if addr >= 0xF0000 then return end -- ROM Read-only 보호
		
		self.Memory[addr] = ((value or 0) & 0xFF)
	end
	
	method void RaiseHardwareInterrupt(number irq)
		if self.PIC then
			self.PIC.PIC8259:RaiseIRQ(irq)
		end
	end
	
	method number GetFlag(number bit)
		local f = math.floor(self.Reg.Flags or 0)
		return (f >> bit) & 1
	end
	
	method void SetFlag(number bit, boolean value)
		local f = math.floor(self.Reg.Flags or 0)
		if value then
			self.Reg.Flags = f | (1 << bit)
		else
			self.Reg.Flags = f & ~(1 << bit)
		end
	end
	
	method void HandleHardwareInterrupts()
		-- IF(Interrupt Flag)가 꺼져있으면(bit 9) 하드웨어 인터럽트 무시
		if self:GetFlag(9) == 0 then return end
		
		if self.PIC then
			local pic = self.PIC.PIC8259
			local irq = pic:GetPendingInterrupt()
			
			if irq ~= -1 then
				pic:AcknowledgeInterrupt(irq)
				
				if self.State == "HALT" then
					self.State = "RUNNING"
				end
				
				self:ExecuteInterrupt(pic.VectorOffset + irq)
			end
		end
	end
	
	method void ExecuteInterrupt(number vector)
		local baseAddr = (vector or 0) * 4
		local newIP = self:ReadWord(baseAddr)
		local newCS = self:ReadWord(baseAddr + 2)
		
		local handledByHLE = false
		if vector == 0x08 then
			self:HandleTimerInterrupt()
			handledByHLE = true
		elseif vector == 0x10 then
			self:HandleVideoInterrupt()
			handledByHLE = true
		elseif vector == 0x13 then
			self:HandleDiskInterrupt()
			handledByHLE = true
		elseif vector == 0x16 then
			self:HandleKeyboardInterrupt()
			handledByHLE = true
		elseif vector == 0x19 then
			self:HandleBootInterrupt()
			handledByHLE = true
		end
		
		if handledByHLE then
			if self.PIC then
				local pic = self.PIC.PIC8259
				if vector >= pic.VectorOffset and vector <= pic.VectorOffset + 7 then
					pic:Write(0x20, 0x20)
				end
			end
			return
		end
		
		if (newIP or 0) == 0 and (newCS or 0) == 0 then
			log(string.format("Warning: Undefined Interrupt INT %02Xh called!", (vector or 0)))
			return
		end
		
		self:Push16(self.Reg.Flags)
		self:Push16(self.Reg.CS)
		self:Push16(self.Reg.IP)
		
		self:SetFlag(9, false)
		self:SetFlag(8, false)
		
		self.Reg.IP = (newIP or 0) & 0xFFFF
		self.Reg.CS = (newCS or 0) & 0xFFFF
	end
	
	method void Push16(number val)
		self.Reg.SP = (self.Reg.SP - 2) & 0xFFFF
		local physicalAddr = (self.Reg.SS << 4) + self.Reg.SP
		self:WriteByte(physicalAddr, (val or 0) & 0xFF)
		self:WriteByte(physicalAddr + 1, ((val or 0) >> 8) & 0xFF)
	end
	
	method void HandleVideoInterrupt()
		local ah = ((self.Reg.AX or 0) >> 8) & 0xFF
		local al = (self.Reg.AX or 0) & 0xFF
		
		if ah == 0x0E then
			if al == 0x0D then
				self.VGA.GraphicsCard.CursorX = 0
				return
			elseif al == 0x0A then
				self.VGA.GraphicsCard.CursorY = self.VGA.GraphicsCard.CursorY + 1
				return
			elseif al == 0x08 then
				self.VGA.GraphicsCard.CursorX = math.max(0, self.VGA.GraphicsCard.CursorX - 1)
				return
			end
			
			if al >= 32 then
				local char = string.char(al)
				if self.VGA and self.VGA.GraphicsCard then
					local posX = 20 + (self.VGA.GraphicsCard.CursorX * 8)
					local posY = 460 - (self.VGA.GraphicsCard.CursorY * 16)
					self.VGA.GraphicsCard:DrawString(char, posX, posY)
				end
				
				self.VGA.GraphicsCard.CursorX = self.VGA.GraphicsCard.CursorX + 1
				if self.VGA.GraphicsCard.CursorX >= 80 then
					self.VGA.GraphicsCard.CursorX = 0
					self.VGA.GraphicsCard.CursorY = self.VGA.GraphicsCard.CursorY + 1
				end
			end
		elseif ah == 0x06 or ah == 0x00 then
			if self.VGA and self.VGA.GraphicsCard then
				self.VGA.GraphicsCard:ClearScreen()
			end
			self.VGA.GraphicsCard.CursorX = 0
			self.VGA.GraphicsCard.CursorY = 0
		end
	end
	
	method void HandleDiskInterrupt()
		local ah = ((self.Reg.AX or 0) >> 8) & 0xFF
		local al = (self.Reg.AX or 0) & 0xFF
		local ch = ((self.Reg.CX or 0) >> 8) & 0xFF
		local cl = (self.Reg.CX or 0) & 0xFF
		local dh = ((self.Reg.DX or 0) >> 8) & 0xFF
		local dl = (self.Reg.DX or 0) & 0xFF
		local es = self.Reg.ES or 0
		local bx = self.Reg.BX or 0
		
		if ah == 0x02 then
			local success = self.FDD.FloppyDrive:ReadSectors(ch, dh, cl & 0x3F, al, es, bx)
			
			if success then
				self.Reg.Flags = (self.Reg.Flags or 0) & (~1)
				self.Reg.AX = ((self.Reg.AX or 0) & 0x00FF) | 0x0000
			else
				self.Reg.Flags = (self.Reg.Flags or 0) | 1
				self.Reg.AX = ((self.Reg.AX or 0) & 0x00FF) | 0x0100
			end
		elseif ah == 0x08 then
			self.Reg.Flags = (self.Reg.Flags or 0) & (~1)
			self.Reg.AX = 0
			self.Reg.BX = 0x0004
			self.Reg.CX = (79 << 8) | 18
			self.Reg.DX = (1 << 8) | 1
			self.Reg.ES = 0xF000
			self.Reg.DI = 0x0080
			log("BIOS: INT 13h Get Drive Parameters (1.44MB Floppy)")
		end
	end
	
	method void HandleKeyboardInterrupt()
		local ah = ((self.Reg.AX or 0) >> 8) & 0xFF
		
		if ah == 0x01 then
			self:UpdateFlags(self.lastKeycode, "LOGIC")
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | ((self.lastKeycode or 0) & 0xFF)
		elseif ah == 0x00 then
			local al = self.lastKeycode or 0
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | (al & 0xFF)
			self.lastKeycode = 0
			self:UpdateFlags(al, "LOGIC")
		end
	end
	
	method void HandleBootInterrupt()
		local fdd = self.FDD.FloppyDrive
		local success = fdd:ReadSectors(0, 0, 1, 1, 0x0000, 0x7C00)
		
		if success then
			log("CPU: Booting... Jumping to 0000:7C00")
			self.Reg.CS = 0x0000
			self.Reg.IP = 0x7C00
			self.Reg.Flags = (self.Reg.Flags or 0) & ~0x0001
		else
			self.Reg.Flags = (self.Reg.Flags or 0) | 0x0001
			log("Disk: Boot sector not found. Returning to BIOS.")
		end
	end
	
	method void HandleSoundDevice(number port, number val)
		local sound = self.Speaker.SoundComponent
		if not sound then return end
		log(string.format("SPEAKER: Port %02X, Value %02X", (port or 0), (val or 0)))
		if port == 0x400 then
			if val == 1 then sound:Play() elseif val == 0 then sound:Stop() end
		elseif port == 0x402 then
			sound.Pitch = 0.5 + ((val or 0) / 128)
		elseif port == 0x404 then
			sound.Volume = (val or 0) / 100
		end
	end
	
	method void Step()
		if self.State ~= "RUNNING" then return end
		
		local opcode = self:FetchByte()
		if opcode == 0x00 then -- ADD r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local addr = nil
			if mod < 3 then addr = self:CalculateAddress(mod, rm) end
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local result = (dest + src) & 0xFF
			self:UpdateFlags(dest + src, "ADD8")
			if mod == 3 then self:SetRegister8(rm, result) else self:WriteByte(addr, result) end
			
		elseif opcode == 0x01 then -- ADD r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local addr = nil
			if mod < 3 then addr = self:CalculateAddress(mod, rm) end
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local result = (dest + src) & 0xFFFF
			self:UpdateFlags(dest + src, "ADD")
			if mod == 3 then self:SetRegister16(rm, result) else self:WriteWord(addr, result) end
			
		elseif opcode == 0x02 then -- ADD r8, r/m8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local dest = self:GetRegister8(reg)
			local addr = nil
			if mod < 3 then addr = self:CalculateAddress(mod, rm) end
			local src = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local fullResult = dest + src
			local result = fullResult & 0xFF
			self:UpdateFlags(fullResult, "ADD8")
			self:SetRegister8(reg, result)
			
		elseif opcode == 0x03 then -- ADD r16, r/m16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local dest = self:GetRegister16(reg)
			local src = self:ReadRM16(mod, rm)
			local result = dest + src
			self:SetFlagsAdd16(dest, src, result)
			self:SetRegister16(reg, result & 0xFFFF)
			
		elseif opcode == 0x04 then -- ADD AL, imm8
			local imm8 = self:FetchByte()
			local al = (self.Reg.AX or 0) & 0xFF
			local fullResult = al + imm8
			local result = fullResult & 0xFF
			self:UpdateFlags(fullResult, "ADD8")
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | result
			
		elseif opcode == 0x05 then -- ADD AX, imm16
			local imm16 = self:FetchWord()
			local res = ((self.Reg.AX or 0) + imm16)
			self:UpdateFlags(res, "ADD")
			self.Reg.AX = res & 0xFFFF
			
		elseif opcode == 0x06 then -- PUSH ES
			self:PushStack(self.Reg.ES or 0)
			
		elseif opcode == 0x07 then -- POP ES
			self.Reg.ES = self:PopStack() & 0xFFFF
			
		elseif opcode == 0x08 then -- OR r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local result = (dest | src) & 0xFF
			self:UpdateFlags(result, "LOGIC8")
			if mod == 3 then self:SetRegister8(rm, result) else self:WriteByte(addr, result) end
			
		elseif opcode == 0x09 then -- OR r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local result = (dest | src) & 0xFFFF
			self:UpdateFlags(result, "LOGIC")
			if mod == 3 then self:SetRegister16(rm, result) else self:WriteWord(addr, result) end
			
		elseif opcode == 0x0A then -- OR r8, r/m8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local result = (dest | src) & 0xFF
			self:UpdateFlags(result, "LOGIC8")
			self:SetRegister8(reg, result)
			
		elseif opcode == 0x0B then -- OR r16, r/m16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local result = (dest | src) & 0xFFFF
			self:UpdateFlags(result, "LOGIC")
			self:SetRegister16(reg, result)
			
		elseif opcode == 0x0C then -- OR AL, imm8
			local imm = self:FetchByte()
			local result = (((self.Reg.AX or 0) & 0xFF) | imm) & 0xFF
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | result
			self:UpdateFlags(result, "LOGIC8")
			
		elseif opcode == 0x0D then -- OR AX, imm16
			local res = ((self.Reg.AX or 0) | self:FetchWord()) & 0xFFFF
			self:UpdateFlags(res, "LOGIC")
			self.Reg.AX = res
			
		elseif opcode == 0x0E then -- PUSH CS
			self:PushStack(self.Reg.CS or 0)
			
		elseif opcode == 0x11 then -- ADC r/m16, r16
			local modrm = self:FetchByte()
			local mod, regIdx, rm = self:DecodeModRM(modrm)
			local srcVal = self:GetRegister16(regIdx)
			local carry = (self.Reg.Flags or 0) & 0x0001
			local dest, addr
			if mod == 3 then
				dest = self:GetRegister16(rm)
				local res = dest + srcVal + carry
				self:SetRegister16(rm, res & 0xFFFF)
				self:UpdateFlags(res, "ADD")
			else
				addr = self:CalculateAddress(mod, rm)
				dest = self:ReadWord(addr)
				local res = dest + srcVal + carry
				self:WriteWord(addr, res & 0xFFFF)
				self:UpdateFlags(res, "ADD")
			end
			
		elseif opcode == 0x12 then -- ADC r8, r/m8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local dest = self:GetRegister8(reg)
			local src = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm))
			local carry = (self.Reg.Flags or 0) & 0x0001
			local res = dest + src + carry
			self:UpdateFlags(res, "ADC8")
			self:SetRegister8(reg, res & 0xFF)
			
		elseif opcode == 0x13 then -- ADC r16, r/m16
			local modrm = self:FetchByte()
			local mod, regIdx, rm = self:DecodeModRM(modrm)
			local dest = self:GetRegister16(regIdx)
			local src = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			local carry = (self.Reg.Flags or 0) & 0x0001
			local res = dest + src + carry
			self:SetRegister16(regIdx, res & 0xFFFF)
			self:UpdateFlags(res, "ADD")
			
		elseif opcode == 0x14 then -- ADC AL, imm8
			local imm = self:FetchByte()
			local oldAL = (self.Reg.AX or 0) & 0xFF
			local cf = (self.Reg.Flags or 0) & 0x0001
			local result = oldAL + imm + cf
			local newAL = result & 0xFF
			self:SetFlagsAdd8(oldAL, imm + cf, newAL)
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | newAL
			
		elseif opcode == 0x16 then -- PUSH SS
			self:PushStack(self.Reg.SS or 0)
			
		elseif opcode == 0x1E then -- PUSH DS
			self:PushStack(self.Reg.DS or 0)
			
		elseif opcode == 0x1F then -- POP DS
			self.Reg.DS = self:PopStack() & 0xFFFF
			
		elseif opcode == 0x25 then -- AND AX, imm16
			local res = ((self.Reg.AX or 0) & self:FetchWord()) & 0xFFFF
			self:UpdateFlags(res, "LOGIC")
			self.Reg.AX = res
			
		elseif opcode == 0x26 then -- ES:
			self.segmentOverride = self.Reg.ES
			self:Step()
			return
		elseif opcode == 0x2E then -- CS:
			self.segmentOverride = self.Reg.CS
			self:Step()
			return
		elseif opcode == 0x36 then -- SS:
			self.segmentOverride = self.Reg.SS
			self:Step()
			return
		elseif opcode == 0x3E then -- DS:
			self.segmentOverride = self.Reg.DS
			self:Step()
			return
			
		elseif opcode == 0x28 then -- SUB r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local result = dest - src
			self:UpdateFlags(result, "SUB8")
			if mod == 3 then self:SetRegister8(rm, result & 0xFF) else self:WriteByte(addr, result & 0xFF) end
			
		elseif opcode == 0x29 then -- SUB r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local result = (dest - src) & 0xFFFF
			self:SetFlagsSub16(dest, src, result)
			if mod == 3 then self:SetRegister16(rm, result) else self:WriteWord(addr, result) end
			
		elseif opcode == 0x2D then -- SUB AX, imm16
			local imm16 = self:FetchWord()
			local res = ((self.Reg.AX or 0) - imm16)
			self:UpdateFlags(res, "SUB")
			self.Reg.AX = res & 0xFFFF
			
		elseif opcode == 0x30 then -- XOR r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local result = dest ~ src
			self:UpdateFlags(result, "LOGIC8")
			if mod == 3 then self:SetRegister8(rm, result) else self:WriteByte(addr, result) end
			
		elseif opcode == 0x31 then -- XOR r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local result = (dest ~ src) & 0xFFFF
			self:UpdateFlags(result, "LOGIC")
			if mod == 3 then self:SetRegister16(rm, result) else self:WriteWord(addr, result) end
			
		elseif opcode == 0x32 then -- XOR r8, r/m8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local dest = self:GetRegister8(reg)
			local src = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm))
			local result = (dest ~ src) & 0xFF
			self:UpdateFlags(result, "LOGIC8")
			self:SetRegister8(reg, result)
			
		elseif opcode == 0x35 then -- XOR AX, imm16
			local res = ((self.Reg.AX or 0) ~ self:FetchWord()) & 0xFFFF
			self:UpdateFlags(res, "LOGIC")
			self.Reg.AX = res
			
		elseif opcode == 0x38 then -- CMP r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local srcVal = self:GetRegister8(reg)
			local destVal = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm))
			self:UpdateFlags(destVal - srcVal, "SUB8")
			
		elseif opcode == 0x39 then -- CMP r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local srcVal = self:GetRegister16(reg)
			local destVal = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			self:UpdateFlags(destVal - srcVal, "SUB")
			
		elseif opcode == 0x3B then -- CMP r16, r/m16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local destVal = self:GetRegister16(reg)
			local srcVal = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			self:UpdateFlags(destVal - srcVal, "SUB")
			
		elseif opcode == 0x3C then -- CMP AL, imm8
			local imm8 = self:FetchByte()
			self:UpdateFlags(((self.Reg.AX or 0) & 0xFF) - imm8, "CMP8")
			
		elseif opcode >= 0x40 and opcode <= 0x47 then -- INC r16
			local regIdx = opcode - 0x40
			local val = self:GetRegister16(regIdx)
			local result = (val + 1) & 0xFFFF
			self:SetRegister16(regIdx, result)
			self:UpdateFlags(result, "INC")
			
		elseif opcode >= 0x48 and opcode <= 0x4F then -- DEC r16
			local regIdx = opcode - 0x48
			local val = self:GetRegister16(regIdx)
			local result = (val - 1) & 0xFFFF
			self:SetRegister16(regIdx, result)
			self:UpdateFlags(result, "DEC")
			
		elseif opcode >= 0x50 and opcode <= 0x57 then -- PUSH r16
			local regNames = {"AX", "CX", "DX", "BX", "SP", "BP", "SI", "DI"}
			self:PushStack(self.Reg[regNames[opcode - 0x50 + 1]] or 0)
			
		elseif opcode >= 0x58 and opcode <= 0x5F then -- POP r16
			local regNames = {"AX", "CX", "DX", "BX", "SP", "BP", "SI", "DI"}
			self.Reg[regNames[opcode - 0x58 + 1]] = self:PopStack() & 0xFFFF
			
		elseif opcode == 0x68 then -- PUSH imm16
			self:PushStack(self:FetchWord())
			
		elseif opcode == 0x6A then -- PUSH imm8 (sign-extended)
			local val = self:FetchByte()
			if val > 127 then val = val - 256 end
			self:PushStack(val & 0xFFFF)
			
		elseif opcode == 0x6C then -- INSB
			local port = self.Reg.DX or 0
			local val = self:ReadPort8(port)
			local physAddr = (((self.Reg.ES or 0) << 4) + (self.Reg.DI or 0)) & 0xFFFFF
			self:WriteByte(physAddr, val)
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			self.Reg.DI = (self.Reg.DI + (df and -1 or 1)) & 0xFFFF
			
		elseif (opcode >= 0x70 and opcode <= 0x7F) or opcode == 0xE3 then -- Conditional Jumps
			local rel = self:FetchByte()
			if rel > 127 then rel = rel - 256 end
			local jump = false
			local f = math.floor(self.Reg.Flags or 0)
			local cf, zf, sf, of, pf = f & 1, (f >> 6) & 1, (f >> 7) & 1, (f >> 11) & 1, (f >> 2) & 1
			if opcode == 0x70 then jump = (of == 1)
			elseif opcode == 0x71 then jump = (of == 0)
			elseif opcode == 0x72 then jump = (cf == 1)
			elseif opcode == 0x73 then jump = (cf == 0)
			elseif opcode == 0x74 then jump = (zf == 1)
			elseif opcode == 0x75 then jump = (zf == 0)
			elseif opcode == 0x76 then jump = (cf == 1 or zf == 1)
			elseif opcode == 0x77 then jump = (cf == 0 and zf == 0)
			elseif opcode == 0x78 then jump = (sf == 1)
			elseif opcode == 0x79 then jump = (sf == 0)
			elseif opcode == 0x7A then jump = (pf == 1)
			elseif opcode == 0x7B then jump = (pf == 0)
			elseif opcode == 0x7C then jump = (sf ~= of)
			elseif opcode == 0x7D then jump = (sf == of)
			elseif opcode == 0x7E then jump = (zf == 1 or sf ~= of)
			elseif opcode == 0x7F then jump = (zf == 0 and sf == of)
			elseif opcode == 0xE3 then jump = ((self.Reg.CX or 0) == 0)
			end
			if jump then self.Reg.IP = (self.Reg.IP + rel) & 0xFFFF end
			
		elseif opcode == 0x80 then -- ALU r/m8, imm8
			local modrm = self:FetchByte()
			local mod, reg_opcode, rm = self:DecodeModRM(modrm)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local val = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(addr)
			local imm8 = self:FetchByte()
			if reg_opcode == 7 then -- CMP
				self:UpdateFlags(val - imm8, "CMP8")
			elseif reg_opcode == 0 then -- ADD
				local res = (val + imm8) & 0xFF
				if mod == 3 then self:SetRegister8(rm, res) else self:WriteByte(addr, res) end
				self:UpdateFlags(val + imm8, "ADD8")
			elseif reg_opcode == 5 then -- SUB
				local res = (val - imm8) & 0xFF
				if mod == 3 then self:SetRegister8(rm, res) else self:WriteByte(addr, res) end
				self:UpdateFlags(val - imm8, "SUB8")
			elseif reg_opcode == 4 then -- AND
				local res = (val & imm8) & 0xFF
				if mod == 3 then self:SetRegister8(rm, res) else self:WriteByte(addr, res) end
				self:UpdateFlags(res, "LOGIC8")
			end
			
		elseif opcode == 0x81 or opcode == 0x83 then -- ALU r/m16, imm16 / imm8
			local modrm = self:FetchByte()
			local mod, reg_op, rm = self:DecodeModRM(modrm)
			local addr = (mod < 3) and self:CalculateAddress(mod, rm) or nil
			local val = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(addr)
			local imm = 0
			if opcode == 0x81 then imm = self:FetchWord()
			else imm = self:FetchByte() if imm > 127 then imm = imm - 256 end imm = imm & 0xFFFF end
			local cf = (self.Reg.Flags or 0) & 1
			if reg_op == 0 then -- ADD
				local res = (val + imm) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(val + imm, "ADD")
			elseif reg_op == 1 then -- OR
				local res = (val | imm) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(res, "LOGIC")
			elseif reg_op == 2 then -- ADC
				local res = (val + imm + cf) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(val + imm + cf, "ADD")
			elseif reg_op == 3 then -- SBB
				local res = (val - imm - cf) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(val - imm - cf, "SUB")
			elseif reg_op == 4 then -- AND
				local res = (val & imm) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(res, "LOGIC")
			elseif reg_op == 5 then -- SUB
				local res = (val - imm) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(val - imm, "SUB")
			elseif reg_op == 6 then -- XOR
				local res = (val ~ imm) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(addr, res) end
				self:UpdateFlags(res, "LOGIC")
			elseif reg_op == 7 then -- CMP
				self:UpdateFlags(val - imm, "CMP")
			end
			
		elseif opcode == 0x84 then -- TEST r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister8(reg)
			local dest = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm))
			self:UpdateFlags(dest & src, "LOGIC8")
			
		elseif opcode == 0x85 then -- TEST r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local src = self:GetRegister16(reg)
			local dest = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			self:UpdateFlags(dest & src, "LOGIC")
			
		elseif opcode == 0x88 then -- MOV r/m8, r8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local srcVal = self:GetRegister8(reg)
			if mod == 3 then self:SetRegister8(rm, srcVal) else self:WriteByte(self:CalculateAddress(mod, rm), srcVal) end
			
		elseif opcode == 0x89 then -- MOV r/m16, r16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local val = self:GetRegister16(reg)
			if mod == 3 then self:SetRegister16(rm, val) else self:WriteWord(self:CalculateAddress(mod, rm), val) end
			
		elseif opcode == 0x8A then -- MOV r8, r/m8
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local val = (mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm))
			self:SetRegister8(reg, val)
			
		elseif opcode == 0x8B then -- MOV r16, r/m16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local val = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			self:SetRegister16(reg, val)
			
		elseif opcode == 0x8C then -- MOV r/m16, Sreg
			local modrm = self:FetchByte()
			local mod, sreg, rm = self:DecodeModRM(modrm)
			local sregNames = {"ES", "CS", "SS", "DS"}
			local val = self.Reg[sregNames[sreg + 1]] or 0
			if mod == 3 then self:SetRegister16(rm, val) else self:WriteWord(self:CalculateAddress(mod, rm), val) end
			
		elseif opcode == 0x8D then -- LEA r16, m
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local offset = self:CalculateOffset(mod, rm)
			self:SetRegister16(reg, offset)
			self.segmentOverride = nil
			
		elseif opcode == 0x8E then -- MOV Sreg, r/m16
			local modrm = self:FetchByte()
			local mod, sreg, rm = self:DecodeModRM(modrm)
			local val = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
			if sreg == 0 then self.Reg.ES = val elseif sreg == 2 then self.Reg.SS = val elseif sreg == 3 then self.Reg.DS = val end
			
		elseif opcode == 0x8F then -- POP r/m16
			local modrm = self:FetchByte()
			local val = self:PopStack()
			local mod, subOp, rm = self:DecodeModRM(modrm)
			if mod == 3 then self:SetRegister16(rm, val) else self:WriteWord(self:CalculateAddress(mod, rm), val) end
			
		elseif opcode == 0x90 then -- NOP
		elseif opcode >= 0x91 and opcode <= 0x97 then -- XCHG AX, reg16
			local regIdx = opcode - 0x90
			local temp = self.Reg.AX or 0
			self.Reg.AX = self:GetRegister16(regIdx)
			self:SetRegister16(regIdx, temp)
			
		elseif opcode == 0x98 then -- CBW
			local al = (self.Reg.AX or 0) & 0xFF
			if (al & 0x80) ~= 0 then self.Reg.AX = 0xFF00 | al else self.Reg.AX = al end
			
		elseif opcode == 0x99 then -- CWD
			if ((self.Reg.AX or 0) & 0x8000) ~= 0 then self.Reg.DX = 0xFFFF else self.Reg.DX = 0 end
			
		elseif opcode == 0x9C then -- PUSHF
			self:Push16(self.Reg.Flags or 0)
			
		elseif opcode == 0x9D then -- POPF
			self.Reg.Flags = self:PopStack() & 0xFFFF
			
		elseif opcode == 0xA0 then -- MOV AL, moffs8
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | self:ReadByte(((self.Reg.DS or 0) << 4) + self:FetchWord())
			
		elseif opcode == 0xA1 then -- MOV AX, moffs16
			self.Reg.AX = self:ReadWord(((self.Reg.DS or 0) << 4) + self:FetchWord())
			
		elseif opcode == 0xA2 then -- MOV moffs8, AL
			self:WriteByte(((self.Reg.DS or 0) << 4) + self:FetchWord(), (self.Reg.AX or 0) & 0xFF)
			
		elseif opcode == 0xA3 then -- MOV moffs16, AX
			self:WriteWord(((self.Reg.DS or 0) << 4) + self:FetchWord(), (self.Reg.AX or 0) & 0xFFFF)
			
		elseif opcode == 0xA4 then -- MOVSB
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local src = (((self.segmentOverride or self.Reg.DS or 0) << 4) + (self.Reg.SI or 0)) & 0xFFFFF
			local dst = (((self.Reg.ES or 0) << 4) + (self.Reg.DI or 0)) & 0xFFFFF
			self:WriteByte(dst, self:ReadByte(src))
			local d = df and -1 or 1
			self.Reg.SI = (self.Reg.SI + d) & 0xFFFF
			self.Reg.DI = (self.Reg.DI + d) & 0xFFFF
			
		elseif opcode == 0xA5 then -- MOVSW
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local src = (((self.segmentOverride or self.Reg.DS or 0) << 4) + (self.Reg.SI or 0)) & 0xFFFFF
			local dst = (((self.Reg.ES or 0) << 4) + (self.Reg.DI or 0)) & 0xFFFFF
			self:WriteWord(dst, self:ReadWord(src))
			local d = df and -2 or 2
			self.Reg.SI = (self.Reg.SI + d) & 0xFFFF
			self.Reg.DI = (self.Reg.DI + d) & 0xFFFF
			
		elseif opcode == 0xAA then -- STOSB
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local dst = (((self.Reg.ES or 0) << 4) + (self.Reg.DI or 0)) & 0xFFFFF
			self:WriteByte(dst, (self.Reg.AX or 0) & 0xFF)
			self.Reg.DI = (self.Reg.DI + (df and -1 or 1)) & 0xFFFF
			
		elseif opcode == 0xAB then -- STOSW
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local dst = (((self.Reg.ES or 0) << 4) + (self.Reg.DI or 0)) & 0xFFFFF
			self:WriteWord(dst, (self.Reg.AX or 0) & 0xFFFF)
			self.Reg.DI = (self.Reg.DI + (df and -2 or 2)) & 0xFFFF
			
		elseif opcode == 0xAC then -- LODSB
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local src = (((self.segmentOverride or self.Reg.DS or 0) << 4) + (self.Reg.SI or 0)) & 0xFFFFF
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | self:ReadByte(src)
			self.Reg.SI = (self.Reg.SI + (df and -1 or 1)) & 0xFFFF
			
		elseif opcode == 0xAD then -- LODSW
			local df = ((self.Reg.Flags or 0) & 0x0400) ~= 0
			local src = (((self.segmentOverride or self.Reg.DS or 0) << 4) + (self.Reg.SI or 0)) & 0xFFFFF
			self.Reg.AX = self:ReadWord(src)
			self.Reg.SI = (self.Reg.SI + (df and -2 or 2)) & 0xFFFF
			
		elseif opcode >= 0xB0 and opcode <= 0xB7 then -- MOV reg8, imm8
			self:SetRegister8(opcode - 0xB0, self:FetchByte())
		elseif opcode >= 0xB8 and opcode <= 0xBF then -- MOV reg16, imm16
			self:SetRegister16(opcode - 0xB8, self:FetchWord())
			
		elseif opcode == 0xC3 then -- RET
			self.Reg.IP = self:PopStack()
			
		elseif opcode == 0xC5 then -- LDS r16, m16:16
			local modrm = self:FetchByte()
			local mod, reg, rm = self:DecodeModRM(modrm)
			local addr = self:CalculateAddress(mod, rm)
			self:SetRegister16(reg, self:ReadWord(addr))
			self.Reg.DS = self:ReadWord(addr + 2)
			
		elseif opcode == 0xC6 then -- MOV r/m8, imm8
			local modrm = self:FetchByte()
			local mod, sub, rm = self:DecodeModRM(modrm)
			local imm = self:FetchByte()
			if mod == 3 then self:SetRegister8(rm, imm) else self:WriteByte(self:CalculateAddress(mod, rm), imm) end
			
		elseif opcode == 0xC7 then -- MOV r/m16, imm16
			local modrm = self:FetchByte()
			local mod, sub, rm = self:DecodeModRM(modrm)
			local imm = self:FetchWord()
			if mod == 3 then self:SetRegister16(rm, imm) else self:WriteWord(self:CalculateAddress(mod, rm), imm) end
			
		elseif opcode == 0xCD then -- INT imm8
			self:ExecuteInterrupt(self:FetchByte())
			return
			
		elseif opcode == 0xCF then -- IRET
			self.Reg.IP = self:PopStack()
			self.Reg.CS = self:PopStack()
			self.Reg.Flags = self:PopStack() & 0xFFFF
			
		elseif opcode == 0xD0 or opcode == 0xD1 then -- Shift/Rotate imm1
			local modrm = self:FetchByte()
			local mod, group, rm = self:DecodeModRM(modrm)
			local isWord = (opcode == 0xD1)
			local val = isWord and ((mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))) 
			            or ((mod == 3) and self:GetRegister8(rm) or self:ReadByte(self:CalculateAddress(mod, rm)))
			local res = 0
			if group == 4 then res = val << 1
			elseif group == 5 then res = val >> 1
			elseif group == 7 then local msb = isWord and 0x8000 or 0x80
				res = (val >> 1) | (val & msb)
			end
			if isWord then 
				if mod == 3 then self:SetRegister16(rm, res & 0xFFFF) else self:WriteWord(self:CalculateAddress(mod, rm), res & 0xFFFF) end
				self:UpdateFlags(res, "ADD")
			else 
				if mod == 3 then self:SetRegister8(rm, res & 0xFF) else self:WriteByte(self:CalculateAddress(mod, rm), res & 0xFF) end
				self:UpdateFlags(res, "ADD8")
			end
			
		elseif opcode == 0xE2 then -- LOOP
			local rel = self:FetchByte()
			if rel > 127 then rel = rel - 256 end
			self.Reg.CX = ((self.Reg.CX or 0) - 1) & 0xFFFF
			if self.Reg.CX ~= 0 then self.Reg.IP = (self.Reg.IP + rel) & 0xFFFF end
			
		elseif opcode == 0xE4 or opcode == 0xEC then -- IN AL
			local port = (opcode == 0xE4) and self:FetchByte() or (self.Reg.DX or 0)
			self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | (self:ReadPort8(port) & 0xFF)
			
		elseif opcode == 0xE6 or opcode == 0xEE then -- OUT AL
			local port = (opcode == 0xE6) and self:FetchByte() or (self.Reg.DX or 0)
			self:WritePort(port, (self.Reg.AX or 0) & 0xFF)
			
		elseif opcode == 0xE8 then -- CALL rel16
			local rel = self:FetchWord()
			if rel > 32767 then rel = rel - 65536 end
			self:Push16(self.Reg.IP)
			self.Reg.IP = (self.Reg.IP + rel) & 0xFFFF
			
		elseif opcode == 0xE9 then -- JMP rel16
			local rel = self:FetchWord()
			if rel > 32767 then rel = rel - 65536 end
			self.Reg.IP = (self.Reg.IP + rel) & 0xFFFF
			
		elseif opcode == 0xEA then -- JMP far
			local ip = self:FetchWord()
			local cs = self:FetchWord()
			self.Reg.IP, self.Reg.CS = ip, cs
			
		elseif opcode == 0xEB then -- JMP short
			local rel = self:FetchByte()
			if rel > 127 then rel = rel - 256 end
			self.Reg.IP = (self.Reg.IP + rel) & 0xFFFF
			
		elseif opcode == 0xF3 then -- REP
			local nextOp = self:FetchByte()
			-- TODO: REP의 완전한 구현
			
		elseif opcode == 0xF4 then 
			self.State = "HALT" 
			log("CPU: Halted.")
			
		elseif opcode == 0xF8 then self:SetFlag(0, false)
		elseif opcode == 0xF9 then self:SetFlag(0, true)
		elseif opcode == 0xFA then self:SetFlag(9, false)
		elseif opcode == 0xFB then self:SetFlag(9, true)
		elseif opcode == 0xFC then self:SetFlag(10, false)
		elseif opcode == 0xFD then self:SetFlag(10, true)
		
		elseif opcode == 0xFF then -- Group 5
			local modrm = self:FetchByte()
			local mod, group, rm = self:DecodeModRM(modrm)
			if group == 0 then -- INC
				local val = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
				local res = (val + 1) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(self:CalculateAddress(mod, rm), res) end
				self:UpdateFlags(res, "INC")
			elseif group == 1 then -- DEC
				local val = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
				local res = (val - 1) & 0xFFFF
				if mod == 3 then self:SetRegister16(rm, res) else self:WriteWord(self:CalculateAddress(mod, rm), res) end
				self:UpdateFlags(res, "DEC")
			elseif group == 2 then -- CALL Near
				local target = (mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))
				self:Push16(self.Reg.IP)
				self.Reg.IP = target & 0xFFFF
			elseif group == 4 then -- JMP Near
				self.Reg.IP = ((mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm))) & 0xFFFF
			elseif group == 6 then -- PUSH
				self:Push16((mod == 3) and self:GetRegister16(rm) or self:ReadWord(self:CalculateAddress(mod, rm)))
			end
		else
			self:HandleException(opcode)
		end
		self.segmentOverride = nil
	end
	
	method void HandleException(number opcode)
		local errorMsg = string.format("\n[CPU EXCEPTION] Unknown Opcode: %02X at %04X:%04X\n", (opcode or 0), (self.Reg.CS or 0), ((self.Reg.IP or 0) - 1))
		errorMsg = errorMsg .. string.format("AX: %04X BX: %04X CX: %04X DX: %04X\nCS: %04X IP: %04X SS: %04X SP: %04X\n",
			(self.Reg.AX or 0), (self.Reg.BX or 0), (self.Reg.CX or 0), (self.Reg.DX or 0), (self.Reg.CS or 0), (self.Reg.IP or 0), (self.Reg.SS or 0), (self.Reg.SP or 0))
		log_error(errorMsg)
		_UIPopup:Open(errorMsg, function() end, function() end)
		self.State = "STOP"
	end
	
	method void HandleStringExeption(string str)
		log_error(str)
		_UIPopup:Open(str, function() end, function() end)
	end
	
	method number ReadPort8(number port)
		if port >= 0x1F0 and port <= 0x1F7 then
			if self.FDD then return self.FDD.FloppyDrive:OnReadPort(port) or 0xFF end
		elseif port == 0x3D4 or port == 0x3D5 or port == 0x3DA then
			if self.VGA then return self.VGA.GraphicsCard:OnReadPort(port) or 0xFF end
		elseif port == 0x60 or port == 0x64 then
			return self:HandleKeyboardPort(port) or 0
		end
		return 0xFF
	end
	
	method void WritePort(number port, number val)
		if port >= 0x1F0 and port <= 0x1F7 then if self.FDD then self.FDD.FloppyDrive:OnWritePort(port, val) end
		elseif port == 0x3D4 or port == 0x3D5 then if self.VGA then self.VGA.GraphicsCard:OnWritePort(port, val) end
		elseif port == 0x20 or port == 0x21 then if self.PIC then self.PIC.PIC8259:Write(port, val) end
		elseif port >= 0x400 and port <= 0x404 then self:HandleSoundDevice(port, val) end
	end
	
	method number FetchByte()
		local physAddr = (((self.Reg.CS or 0) << 4) + (self.Reg.IP or 0)) & 0xFFFFF
		local val = self:ReadByte(physAddr)
		self.Reg.IP = ((self.Reg.IP or 0) + 1) & 0xFFFF
		return val or 0
	end
	
	method number FetchWord()
		local low = self:FetchByte()
		local high = self:FetchByte()
		return ((high or 0) << 8) | (low or 0)
	end
	
	method number ReadWord(number addr)
		return (self:ReadByte(addr) or 0) | ((self:ReadByte(addr + 1) or 0) << 8)
	end
	
	method void WriteWord(number addr, number val)
		self:WriteByte(addr, (val or 0) & 0xFF)
		self:WriteByte(addr + 1, ((val or 0) >> 8) & 0xFF)
	end
	
	method void PushStack(number value)
		self.Reg.SP = ((self.Reg.SP or 0) - 2) & 0xFFFF
		local physAddr = (((self.Reg.SS or 0) << 4) + (self.Reg.SP or 0)) & 0xFFFFF
		self:WriteWord(physAddr, (value or 0))
	end
	
	method number PopStack()
		local physAddr = (((self.Reg.SS or 0) << 4) + (self.Reg.SP or 0)) & 0xFFFFF
		local val = self:ReadWord(physAddr)
		self.Reg.SP = ((self.Reg.SP or 0) + 2) & 0xFFFF
		return val or 0
	end
	
	method any DecodeModRM(number modrm)
		return ((modrm or 0) >> 6) & 0x03, ((modrm or 0) >> 3) & 0x07, (modrm or 0) & 0x07
	end
	
	method number CalculateOffset(number mod, number rm)
		local base = 0
		if mod == 0 and rm == 6 then return self:FetchWord() or 0 end
		local disp = 0
		if mod == 1 then disp = self:FetchByte() or 0 if disp > 127 then disp = disp - 256 end
		elseif mod == 2 then disp = self:FetchWord() or 0 if disp > 32767 then disp = disp - 65536 end end
		if rm == 0 then base = (self.Reg.BX or 0) + (self.Reg.SI or 0)
		elseif rm == 1 then base = (self.Reg.BX or 0) + (self.Reg.DI or 0)
		elseif rm == 2 then base = (self.Reg.BP or 0) + (self.Reg.SI or 0)
		elseif rm == 3 then base = (self.Reg.BP or 0) + (self.Reg.DI or 0)
		elseif rm == 4 then base = (self.Reg.SI or 0)
		elseif rm == 5 then base = (self.Reg.DI or 0)
		elseif rm == 6 then base = (self.Reg.BP or 0)
		elseif rm == 7 then base = (self.Reg.BX or 0) end
		return (base + disp) & 0xFFFF
	end
	
	method number CalculateAddress(number mod, number rm)
		local offset = self:CalculateOffset(mod, rm)
		local segment = self.segmentOverride or self.Reg.DS
		if self.segmentOverride == nil and (mod ~= 0 or rm ~= 6) and (rm == 2 or rm == 3 or rm == 6) then segment = self.Reg.SS end
		return (((segment or 0) << 4) + offset) & 0xFFFFF
	end
	
	method number GetRegister8(number index)
		index = (index or 0) & 7
		if index == 0 then return (self.Reg.AX or 0) & 0xFF
		elseif index == 1 then return (self.Reg.CX or 0) & 0xFF
		elseif index == 2 then return (self.Reg.DX or 0) & 0xFF
		elseif index == 3 then return (self.Reg.BX or 0) & 0xFF
		elseif index == 4 then return ((self.Reg.AX or 0) >> 8) & 0xFF
		elseif index == 5 then return ((self.Reg.CX or 0) >> 8) & 0xFF
		elseif index == 6 then return ((self.Reg.DX or 0) >> 8) & 0xFF
		elseif index == 7 then return ((self.Reg.BX or 0) >> 8) & 0xFF end
		return 0
	end
	
	method void SetRegister8(number index, number val)
		index = (index or 0) & 7 val = (val or 0) & 0xFF
		if index == 0 then self.Reg.AX = ((self.Reg.AX or 0) & 0xFF00) | val
		elseif index == 1 then self.Reg.CX = ((self.Reg.CX or 0) & 0xFF00) | val
		elseif index == 2 then self.Reg.DX = ((self.Reg.DX or 0) & 0xFF00) | val
		elseif index == 3 then self.Reg.BX = ((self.Reg.BX or 0) & 0xFF00) | val
		elseif index == 4 then self.Reg.AX = (val << 8) | ((self.Reg.AX or 0) & 0xFF)
		elseif index == 5 then self.Reg.CX = (val << 8) | ((self.Reg.CX or 0) & 0xFF)
		elseif index == 6 then self.Reg.DX = (val << 8) | ((self.Reg.DX or 0) & 0xFF)
		elseif index == 7 then self.Reg.BX = (val << 8) | ((self.Reg.BX or 0) & 0xFF) end
	end
	
	method number GetRegister16(number index)
		local regs = {"AX", "CX", "DX", "BX", "SP", "BP", "SI", "DI"}
		return self.Reg[regs[(index & 7) + 1]] or 0
	end
	
	method void SetRegister16(number index, number val)
		local regs = {"AX", "CX", "DX", "BX", "SP", "BP", "SI", "DI"}
		self.Reg[regs[(index & 7) + 1]] = (val or 0) & 0xFFFF
	end
	
	method number ReadRM16(number mod, number rm)
		if mod == 3 then return self:GetRegister16(rm) end
		return self:ReadWord(self:CalculateAddress(mod, rm))
	end
	
	method void UpdateFlags(number result, string opType)
		local is8 = string.find(opType, "8") ~= nil
		local mask, signBit = is8 and 0xFF or 0xFFFF, is8 and 0x80 or 0x8000
		local res = math.floor(result or 0) & mask
		local f = math.floor(self.Reg.Flags or 0) & 0xF72A
		if res == 0 then f = f | 0x0040 end
		if (res & signBit) ~= 0 then f = f | 0x0080 end
		local p, count = res & 0xFF, 0
		for i=0,7 do if (p >> i) & 1 == 1 then count = count + 1 end end
		if count % 2 == 0 then f = f | 0x0004 end
		if string.find(opType, "LOGIC") then f = f & ~0x0801
		elseif string.find(opType, "ADD") then if (result or 0) > mask then f = f | 0x0001 end
		elseif string.find(opType, "SUB") or string.find(opType, "CMP") then if (result or 0) < 0 then f = f | 0x0001 end end
		self.Reg.Flags = f
	end
	
	method void SetFlagsSub16(number d, number s, number r)
		local function v(n) if n == nil or n ~= n or n == math.huge or n == -math.huge then return 0 end return math.floor(n) end
		local dv, sv, rv = v(d) % 0x10000, v(s) % 0x10000, v(r) % 0x10000
		local f = v(self.Reg.Flags) & 0xF72A
		if rv == 0 then f = f | 0x0040 end
		if (rv & 0x8000) ~= 0 then f = f | 0x0080 end
		if dv < sv then f = f | 0x0001 end
		if ((dv ^ sv) & 0x8000) ~= 0 and ((dv ^ rv) & 0x8000) ~= 0 then f = f | 0x0800 end
		self.Reg.Flags = f
	end
	
	method void SetFlagsAdd8(number d, number s, number r)
		local function v(n) if n == nil or n ~= n or n == math.huge or n == -math.huge then return 0 end return math.floor(n) end
		local dv, sv, rv = v(d) % 0x100, v(s) % 0x100, v(r) % 0x100
		local f = v(self.Reg.Flags) & 0xF72A
		if rv == 0 then f = f | 0x0040 end
		if (rv & 0x80) ~= 0 then f = f | 0x0080 end
		if (v(r) > 0xFF) then f = f | 0x0001 end
		if ((dv ^ rv) & 0x80) ~= 0 and ((dv ^ sv) & 0x80) == 0 then f = f | 0x0800 end
		self.Reg.Flags = f
	end
	
	method void SetFlagsAdd16(number d, number s, number r)
		local function v(n) if n == nil or n ~= n or n == math.huge or n == -math.huge then return 0 end return math.floor(n) end
		local dv, sv, rv = v(d) % 0x10000, v(s) % 0x10000, v(r) % 0x10000
		local f = v(self.Reg.Flags) & 0xF72A
		if rv == 0 then f = f | 0x0040 end
		if (rv & 0x8000) ~= 0 then f = f | 0x0080 end
		if (v(r) > 0xFFFF) then f = f | 0x0001 end
		if ((dv ^ rv) & 0x8000) ~= 0 and ((dv ^ sv) & 0x8000) == 0 then f = f | 0x0800 end
		self.Reg.Flags = f
	end

	method void HandleTimerInterrupt()
		local count = (self:ReadByte(0x46C) + (self:ReadByte(0x46D) * 256) + 1) % 65536
		self:WriteByte(0x46C, count % 256)
		self:WriteByte(0x46D, math.floor(count / 256))
	end

	method void ExecuteBatch()
		if self.State ~= "RUNNING" then return end
		for i = 1, self.ProcessorSpeed do
			self:HandleHardwareInterrupts()
			if self.State == "RUNNING" then self:Step() else break end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number dt)
		if self.State == "STOP" or (self.FDD and self.FDD.FloppyDrive and not self.FDD.FloppyDrive.IsReady) then return end
		self.TimerAccumulator = (self.TimerAccumulator or 0) + dt
		if self.TimerAccumulator >= 0.0549 then self:RaiseHardwareInterrupt(0) self.TimerAccumulator = 0 end
		self:ExecuteBatch()
	end

	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if self.State == "STOP" then return end
		local ascii = self.KeyMap[event.key]
		if ascii then
			local shift = _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift)
			if shift then if ascii >= 97 and ascii <= 122 then ascii = ascii - 32 end end
			self.lastKeycode = ascii
			self:RaiseHardwareInterrupt(1)
			if self.State == "HALT" then self.State = "RUNNING" end
		end
	end
	
	method number HandleKeyboardPort(number port)
		if port == 0x60 then return self.lastKeycode or 0
		elseif port == 0x64 then return (self.lastKeycode ~= 0) and 1 or 0 end
		return 0
	end
end