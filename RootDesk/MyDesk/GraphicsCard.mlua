@Component
script GraphicsCard extends Component
	
	property Entity monitor = "640e47f6-44a9-4e2d-9fd6-ad6094149d00"
	
	property any FontTable = {}
	
	property table BIT_MASK = {128, 64, 32, 16, 8, 4, 2, 1}
	
	property boolean IsReady = false
	
	property table VRAM = {}
	
	property table RenderQueue = {}
	
	property table FrameBuffer = {}
	
	property boolean IsDirty = false
	
	property number ScreenWidth = 640
	
	property number ScreenHeight = 480
	
	property number IndexRegister = 0

	property number CursorLocation = 0 -- 16비트 (High + Low)

	property number tempStatus = 0 -- 가상 수직 동기화 상태용
	
	property number CursorX = 0

	property number CursorY = 0
	@ExecSpace("ClientOnly")
	method void OnInitialize()
		self:ClearScreen()
		local ds = _DataService:GetTable("FontRom")
		if ds then
			-- 폰트 로딩 로직 (기존과 동일)
			for i = 1, ds:GetRowCount() do
				local ascii = tonumber(ds:GetCell(i, "Sector"))
				local hexStr = ds:GetCell(i, "Data")
				if ascii and hexStr then
					local charData = {}
					for j = 0, 15 do
						local num = tonumber(string.sub(hexStr, (j * 2) + 1, (j * 2) + 2), 16) or 0
						local bitRow = {}
						for col = 1, 8 do bitRow[col] = math.floor(num / self.BIT_MASK[col]) % 2 == 1 end
						charData[j + 1] = bitRow
					end
					self.FontTable[ascii] = charData
				end
			end
		end
		
		self:InitializeFrameBuffer()
		self.IsReady = true
	end
	
	@ExecSpace("ClientOnly")
	method void InitializeFrameBuffer()
		local totalPixels = self.ScreenWidth * self.ScreenHeight
		for i = 1, totalPixels do
			self.FrameBuffer[i] = Color.black
		end
	end
	
	@ExecSpace("ClientOnly")
	method void DrawString(string text, number startX, number startY)
		if not self.IsReady then return end
		
		for i = 1, #text do
			local charCode = string.byte(text, i)
			local drawX = startX + (i - 1) * 8
			local vramKey = tostring(drawX) .. "_" .. tostring(startY)
			
			if self.VRAM[vramKey] ~= charCode then
				-- row를 1부터 16까지 한꺼번에 처리할 큐 생성
				table.insert(self.RenderQueue, {code = charCode, x = drawX, y = startY, row = 1})
				-- DEBUG
				-- log(string.format("DrawString: Char: %d, X: %d, Y: %d", charCode, startX, startY))
				self.VRAM[vramKey] = charCode
			end
		end
	end
	
	@ExecSpace("ClientOnly")
	method void OnUpdate(number dt)
		if #self.RenderQueue == 0 and not self.IsDirty then return end
		
		local pixelRenderer = self.monitor.PixelGUIRendererComponent
		if not pixelRenderer then return end
		
		-- ✅ 1. 시분할로 버퍼 채우기
		-- 렉을 안 걸리게 하면서도 최대한 많이 처리 (행 단위 32개 정도면 안전)
		local processedRows = 0
		local maxRowsPerFrame = 512
		
		while #self.RenderQueue > 0 and processedRows < maxRowsPerFrame do
			local job = table.remove(self.RenderQueue, 1)
			self:DrawSingleRowToBuffer(job)
			processedRows = processedRows + 1
			
			if job.row < 16 then
				job.row = job.row + 1
				table.insert(self.RenderQueue, job)
			else
				-- ✅ 한 글자가 완전히 다 그려졌을 때만 Dirty 플래그를 세운다
				self.IsDirty = true
			end
		end
		
		-- ✅ 2. 화면 스왑 (렌더링)
		-- 모든 행 처리가 끝났거나, 중요한 업데이트가 있을 때만 호출
		if self.IsDirty and #self.RenderQueue == 0 then
			pixelRenderer:SetPixels(self.FrameBuffer)
			self.IsDirty = false
		end
	end
	
	method void DrawSingleRowToBuffer(table job)
		local charData = self.FontTable[job.code]
		if not charData then return end
		
		local bitRow = charData[job.row]
		local drawY = job.y + (16 - job.row)
		
		for col = 1, 8 do
			local x = job.x + col - 1
			local y = drawY
			local index = y * self.ScreenWidth + x + 1
			
			if index > 0 and index <= #self.FrameBuffer then
				self.FrameBuffer[index] = bitRow[col] and Color.white or Color.black
			end
		end
	end
	
	@ExecSpace("ClientOnly")
	method void ClearScreen()
		local pixelRenderer = self.monitor.PixelGUIRendererComponent
		if pixelRenderer then pixelRenderer:FillColor(Color.black) end
		self.VRAM = {}
		self.RenderQueue = {}
		-- 프레임버퍼도 한 번에 초기화 (MSW에서 30만개 루프는 프레임당 1회는 허용될 수 있으나 부하를 줄임)
		self.IsDirty = true
	end
	
	method void ScrollUP()
		local lineHeight = 16
		local pixelShift = lineHeight + self.ScreenWidth
		local totalPixels = self.ScreenWidth * self.ScreenHeight
		
		-- 윗쪽으로 픽셀복사
		table.move(self.FrameBuffer, pixelShift + 1, totalPixels, 1)
		
		-- 맨 아랫쪽에 생긴 빈 공간 을 검은색 으로 채우기
		for i = totalPixels - pixelShift + 1, totalPixels do
			self.FrameBuffer[i] = Color.black
		end
		-- Vram 초기화
		self.VRAM = {}
		
		-- 즉시 화면 예약
		self.IsDirty = true
	end
	
	method void OnWritePort(number port, number val)
		if port == 0x3D4 then -- CRT Controller Index
			self.IndexRegister = val
		elseif port == 0x3D5 then -- CRT Controller Data
			self:HandleCRTCWrite(self.IndexRegister, val)
		end
	end
	method void HandleCRTCWrite(number index, number val)
		-- 커서 위치 설정
		if index == 0x0E then
			self.CursorLocation = (self.CursorLocation & 0x00FF) | (val << 8)
			self:UpdateCursor()
		elseif index == 0x0F then
			self.CursorLocation = (self.CursorLocation & 0xFF00) | val
			self:UpdateCursor()
		end
	end
	method void UpdateCursor()
		local cols = 80
		local x = self.CursorLocation % cols
		local y = math.floor(self.CursorLocation / cols)

		self.CursorX = x
		self.CursorY = y
	end
	method number OnReadPort(number port)
		if port == 0x3D4 then
			return self.IndexRegister
		elseif port == 0x3D5 then
			-- 커서읽기
			if self.IndexRegister == 0x0E then
				return (self.CursorLocation >> 8) & 0xFF
			elseif self.IndexRegister == 0x0F then
				return self.CursorLocation & 0xFF
			end
		elseif port == 0x3DA then
			-- Bit3: Vertical Retrace
			self.tempStatus = (self.tempStatus == 0) and 0x08 or 0x00
			return self.tempStatus
		end
		return 0xFF
	end
end