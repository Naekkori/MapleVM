@Component
script PIC8259 extends Component

	property number MasterIMR = 0xFC

	property number MasterIRR = 0

	property number MasterISR = 0

	property number MasterVectorOffset = 0x08

	property number VectorOffset = 0x08 -- CPUCore 참조용 일반 프로퍼티 추가

	property number SlaveIMR = 0xFF

	property number SlaveIRR = 0

	property number SlaveISR = 0

	property number SlaveVectorOffset = 0x70

	property number MasterInitStep = 0

	property number SlaveInitStep = 0

	property boolean MasterExpectICW4 = false

	property boolean SlaveExpectICW4 = false

	method void Write(number port, number val)
		if port == 0x20 then -- Master Command
			if (val & 0x10) ~= 0 then
				self.MasterInitStep = 1
				self.MasterIRR = 0
				self.MasterISR = 0
				self.MasterIMR = 0xFF
				self.MasterExpectICW4 = (val & 0x01) ~= 0
			elseif (val & 0x08) == 0 and (val & 0x10) == 0 then
				if (val & 0x20) ~= 0 then self:ClearHighestISR(true) end
			end
		elseif port == 0x21 then -- Master Data
			if self.MasterInitStep == 1 then
				self.MasterVectorOffset = val & 0xF8
				self.VectorOffset = self.MasterVectorOffset -- 값 업데이트
				self.MasterInitStep = 2
			elseif self.MasterInitStep == 2 then
				self.MasterInitStep = self.MasterExpectICW4 and 3 or 0
			elseif self.MasterInitStep == 3 then
				self.MasterInitStep = 0
			else
				self.MasterIMR = val
			end
		elseif port == 0xA0 then -- Slave Command
			if (val & 0x10) ~= 0 then
				self.SlaveInitStep = 1
				self.SlaveIRR = 0
				self.SlaveISR = 0
				self.SlaveIMR = 0xFF
				self.SlaveExpectICW4 = (val & 0x01) ~= 0
			elseif (val & 0x08) == 0 and (val & 0x10) == 0 then
				if (val & 0x20) ~= 0 then self:ClearHighestISR(false) end
			end
		elseif port == 0xA1 then -- Slave Data
			if self.SlaveInitStep == 1 then
				self.SlaveVectorOffset = val & 0xF8
				self.SlaveInitStep = 2
			elseif self.SlaveInitStep == 2 then
				self.SlaveInitStep = self.SlaveExpectICW4 and 3 or 0
			elseif self.SlaveInitStep == 3 then
				self.SlaveInitStep = 0
			else
				self.SlaveIMR = val
			end
		end
	end

	method number Read(number port)
		if port == 0x21 then return self.MasterIMR
		elseif port == 0xA1 then return self.SlaveIMR
		end
		return 0
	end

	method number GetPendingInterrupt()
		-- 마스터 확인
		local pending = self.MasterIRR & (~self.MasterIMR)
		if pending ~= 0 then
			for i = 0, 7 do
				if (pending & (1 << i)) ~= 0 then
					-- IRQ 2는 슬레이브 케스케이드
					if i == 2 then
						local sPending = self.SlaveIRR & (~self.SlaveIMR)
						if sPending ~= 0 then
							for j = 0, 7 do
								if (sPending & (1 << j)) ~= 0 then return j + 8 end
							end
						end
					else
						return i
					end
				end
			end
		end
		return -1
	end

	method void RaiseIRQ(number irq)
		if irq < 8 then
			self.MasterIRR = self.MasterIRR | (1 << irq)
		else
			self.SlaveIRR = self.SlaveIRR | (1 << (irq - 8))
			self.MasterIRR = self.MasterIRR | (1 << 2) -- 슬레이브 요청 알림
		end
	end

	method void AcknowledgeInterrupt(number irq)
		if irq < 8 then
			self.MasterIRR = self.MasterIRR & ~(1 << irq)
			self.MasterISR = self.MasterISR | (1 << irq)
		else
			self.SlaveIRR = self.SlaveIRR & ~(1 << (irq - 8))
			self.SlaveISR = self.SlaveISR | (1 << (irq - 8))
			self.MasterISR = self.MasterISR | (1 << 2)
		end
	end

	method void ClearHighestISR(boolean isMaster)
		if isMaster then
			for i = 0, 7 do
				if (self.MasterISR & (1 << i)) ~= 0 then
					self.MasterISR = self.MasterISR & ~(1 << i)
					break
				end
			end
		else
			for i = 0, 7 do
				if (self.SlaveISR & (1 << i)) ~= 0 then
					self.SlaveISR = self.SlaveISR & ~(1 << i)
					break
				end
			end
		end
	end

end