@Component
script FloppyDrive extends Component
	property Entity CPU = "2a7c0ddd-0a37-497c-8287-634179d981f7"
	
	property table HDDImage = nil
	
	property boolean IsReady = false
	
	property string Status = "Ready"
	
	property number MotorAccumulator = 0
	property boolean MotorRunning = false
	
	property table PortBuffer = {}
	property number BufferIndex = 1
	
	@ExecSpace("ClientOnly")
	method void OnInitialize()
		log("Disk: Data Loading...")
		self.HDDImage = {}
		
		-- VHD.csv (2880 sectors) 로드
		local dataSet = _DataService:GetTable("VHD")
		local rowCount = dataSet:GetRowCount()
		
		for i = 1, rowCount do
			local hexData = dataSet:GetCell(i, "Data")
			if hexData then
				-- 한 섹터는 512바이트 (1024 hex chars)
				self.HDDImage[i] = hexData
			end
		end
		
		log("Disk: Data Loading Complete. Total sectors: " .. #self.HDDImage)
	end
	
	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 부팅 전 하드웨어 셀프 테스트 연출
		self.IsReady = false
		log("Disk: System Self-Test Start")
		
		_TimerService:SetTimerOnce(function()
			self.IsReady = true
			log("Disk: System Self-Test Complete - READY")
		end, 4.0)
	end
	
	method void OnUpdate(number dt)
		if self.MotorRunning then
			self.MotorAccumulator = self.MotorAccumulator + dt
			-- 2초간 활동이 없으면 모터 정지 연출
			if self.MotorAccumulator > 2.0 then
				self.MotorRunning = false
				self.MotorAccumulator = 0
				-- log("FDD: Motor Stopped.")
			end
		end
	end
	
	-- 하드웨어 액세스 시 연출 (모터 가동 등)
	method void _ApplyHardwareAccess(number lba)
		self.MotorRunning = true
		self.MotorAccumulator = 0
		-- 실제 게임 내 연출(LED 등)이 필요하면 여기에 추가
	end
	
	method boolean ReadSectors(number c, number h, number s, number count, number es, number bx)
		if not self.IsReady then return false end
		
		-- LBA = (C * (HeadsPerCyl) + H) * SectorsPerTrack + (S - 1)
		-- 표준 1.44MB: Heads = 2, SPT = 18
		-- ELKS 부트로더는 선형 헤드 주소(Head >= 2)를 사용할 수 있으므로 클램핑 금지
		local startLba = (c * 2 + h) * 18 + (s - 1)
		
		self:_ApplyHardwareAccess(startLba)
		
		local cpu = self.CPU.CPUCore
		local baseDestAddr = (es << 4) + bx
		
		log(string.format("FDD: Read %d sectors (C:%d H:%d S:%d) -> LBA:%d to %04X:%04X", count, c, h, s, startLba, es, bx))
		
		for i = 0, count - 1 do
			local currentLba = startLba + i
			local hexData = self.HDDImage[currentLba + 1] -- 1-indexed
			
			if not hexData then
				log_error(string.format("FDD: Sector not found! LBA:%d", currentLba))
				return false
			end
			
			local sectorOffset = i * 512
			for j = 0, 511 do
				local startIdx = (j * 2) + 1
				local byteStr = string.sub(hexData, startIdx, startIdx + 1)
				local byteVal = tonumber(byteStr, 16) or 0
				
				local destAddr = (baseDestAddr + sectorOffset + j) & 0xFFFFF
				cpu:WriteByte(destAddr, byteVal)
			end
		end
		
		return true
	end
	
	method boolean WriteSectors(number c, number h, number s, number count, number es, number bx)
		-- 플로피 쓰기는 현재 미구현 (Read-only)
		return false
	end
	
	-- I/O 포트 에뮬레이션 (FDC 0x3F0-0x3F7 등 필요 시 구현)
	method number OnReadPort(number port)
		return 0xFF
	end
	
	method void OnWritePort(number port, number val)
	end
	
	method number OnReadPort16(number port)
		return 0xFFFF
	end
end