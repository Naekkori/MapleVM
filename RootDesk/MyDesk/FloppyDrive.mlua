@Component
script FloppyDrive extends Component
	property Entity CPU = "2a7c0ddd-0a37-497c-8287-634179d981f7"
	
	property table HDDImage = nil
	
	property boolean IsReady = false
	
	property string Status = "Ready"
	
	property Entity DiskLED = "e559f41b-e6c3-47bd-926b-7e870a53f2a4"
	
	-- LED 및 모터 유지를 위한 타이머
	property number DiskTimer = 0
	property number MotorTimer = 0
	
	-- 현재 헤드 위치 (실린더 번호)
	property number CurrentCylinder = 0
	
	property SoundComponent spindleMotor = "d2f213bf-3620-4736-9897-1e6bf90c0da4"
	property SoundComponent accessHead = "c7af733b-82f9-4268-a28b-9fa368a25238"
	
	-- FDD 에뮬레이션
	property table PortBuffer = {}
	property number BufferIndex = 1
	property number SelectedLBA = 0
	property number SelectedSectorCount = 0
	
	@ExecSpace("ClientOnly")
	method void OnInitialize()
		log("Disk: Data Loading...")
		self.HDDImage = {}
		
		local vhdDataset = _DataService:GetTable("VHD")
		local rowCount = vhdDataset:GetRowCount()
		local loadedCount = 0
		
		for i = 1, rowCount do
			local sectorStr = vhdDataset:GetCell(i, "Sector")
			local dataStr = vhdDataset:GetCell(i, "Data")
			
			if sectorStr and dataStr then
				local sectorNum = tonumber(sectorStr)
				self.HDDImage[sectorNum] = dataStr
				loadedCount = loadedCount + 1
			end
		end
		
		log("Disk: Data Loading Complete. Total sectors: " .. loadedCount)
	end
	
	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		log("Disk: System Self-Test Start")
		
		self.spindleMotor:Play()
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.green
		end
		local headali = self.accessHead
		headali:Play()
		wait(1)
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.FromHexCode("#626262")
		end
		headali.Pitch = 0.5
		headali:Play()
		wait(1)
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.green
		end
		headali:Play()
		wait(1)
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.FromHexCode("#626262")
		end
		headali:Play()
		headali.Pitch = 1.0
		wait(1)
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.green
		end
		self.spindleMotor:Stop()
		self.CurrentCylinder = 0
		self.IsReady = true 
		log("Disk: System Self-Test Complete - READY")
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.FromHexCode("#626262")
		end
	end
	
	method void OnUpdate(number dt)
		if self.DiskTimer > 0 then
			self.DiskTimer = self.DiskTimer - dt
			if self.DiskTimer <= 0 then
				if self.DiskLED then
					self.DiskLED.SpriteGUIRendererComponent.Color = Color.FromHexCode("#626262")
				end
			end
		end
		
		if self.MotorTimer > 0 then
			self.MotorTimer = self.MotorTimer - dt
			if self.MotorTimer <= 0 then
				self.spindleMotor:Stop()
				log("Disk: Spindle Motor Auto-Stop")
			end
		end
	end
	
	method void _ApplyHardwareAccess(number lba)
		if not self.IsReady then return end
		
		if self.MotorTimer <= 0 then
			self.spindleMotor:Play()
		end
		self.MotorTimer = 2.5
		
		if self.DiskLED then
			self.DiskLED.SpriteGUIRendererComponent.Color = Color.green
			self.DiskTimer = 0.5
		end
		
		local headsPerDisk = 2
		local sectorsPerTrack = 18
		local targetCylinder = math.floor(lba / (headsPerDisk * sectorsPerTrack))
		
		if targetCylinder > self.CurrentCylinder then
			self.accessHead.Pitch = 1.15
			self.accessHead:Play()
		elseif targetCylinder < self.CurrentCylinder then
			self.accessHead.Pitch = 0.85
			self.accessHead:Play()
		else
			self.accessHead.Pitch = 1.0
		end
		self.CurrentCylinder = targetCylinder
	end
	
	method boolean ReadSectors(number c, number h, number s, number count, number es, number bx)
		if not self.IsReady then
			log_warning("Disk: Device not ready (Performing Self-Test)")
			return false
		end
		if s < 1 then
			log_warning("DISK: Invalid sector " .. s .. " request, Adjusting 1")
			s = 1
		end
		
		local headsPerDisk = 2
		local sectorsPerTrack = 18
		local startLba = ((c * headsPerDisk) + h) * sectorsPerTrack + (s - 1)
		
		if startLba < 0 then
			log("Disk: LBA calculation error (LBA: " .. startLba .. ")")
			return false
		end
		
		-- 하드웨어 연출 적용
		self:_ApplyHardwareAccess(startLba)
		
		local cpu = self.CPU.CPUCore
		local baseDestAddr = ((es << 4) + bx) & 0xFFFFF 
		
		log(string.format("DISK IO: LBA: %d, Count: %d, ES: %04X, BX: %04X (Addr: %05X)", startLba, count, es, bx, baseDestAddr))
		
		for i = 0, count - 1 do
			local currentLba = startLba + i
			
			-- [패치] 커널 조각 리다이렉션 (1863번 이후 -> 32번 이후)
			if currentLba >= 1863 and currentLba <= 2880 then
				local fragmentLba = currentLba - 1863 + 32
				self.HDDImage[currentLba] = self.HDDImage[fragmentLba]
			end
			
			local hexData = self.HDDImage[currentLba]
			
			if not hexData then
				log_error(string.format("Disk: Sector not found! LBA:%d (C:%d H:%d S:%d)", currentLba, c, h, s + i))
				return false
			end
			
			local preview = string.sub(hexData, 1, 32)
			log(string.format("DISK IO: LBA %d Data: %s", currentLba, preview))
			
			local sectorOffset = i * 512
			for j = 0, 511 do
				local startIdx = (j * 2) + 1
				local byteStr = string.sub(hexData, startIdx, startIdx + 1)
				local byteVal = tonumber(byteStr, 16) or 0
				local destAddr = (baseDestAddr + sectorOffset + j) & 0xFFFFF
				cpu:WriteByte(destAddr, byteVal)
			end
		end
		
		log(string.format("DISK IO: Done. LBA %d to %d copied to %04X:%04X", startLba, startLba + count - 1, es, bx))
		return true
	end
	
	method boolean WriteSectors(number c, number h, number s, number count, number es, number bx)
		if not self.IsReady then return false end
		
		local headsPerDisk = 2
		local sectorsPerTrack = 18
		local startLba = (c * headsPerDisk + h) * sectorsPerTrack + (s - 1)
		
		self:_ApplyHardwareAccess(startLba)
		
		local cpu = self.CPU.CPUCore
		local baseAddr = ((es << 4) + bx) & 0xFFFFF
		for i = 0, count - 1 do
			local currentLba = startLba + i
			local dataStr = ""
			local sectorOffset = i * 512

			for j = 0, 511 do
				local srcAddr = (baseAddr + sectorOffset + j) & 0xFFFFF
				local byteVal = cpu:ReadByte(srcAddr)
				dataStr = dataStr .. string.format("%02X", byteVal)
			end
			self.HDDImage[currentLba] = dataStr
		end
		
		log(string.format("FDD: Write %d sectors (LBA: %d)", count, startLba))
		return true
	end
	
	method void OnWritePort(number port, number val)
		if port == 0x1F2 then 
			self.SelectedSectorCount = val
		elseif port == 0x1F3 then 
			self.SelectedLBA = (self.SelectedLBA & 0xFFFFFF00) | val
		elseif port == 0x1F4 then 
			self.SelectedLBA = (self.SelectedLBA & 0xFFFF00FF) | (val << 8)
		elseif port == 0x1F5 then 
			self.SelectedLBA = (self.SelectedLBA & 0xFF00FFFF) | (val << 16)
		elseif port == 0x1F7 then 
			if val == 0x20 then 
				self:PreparePortBuffer()
			elseif val == 0x30 then 
				self.PortBuffer = {}
				self.BufferIndex = 1
				self:_ApplyHardwareAccess(self.SelectedLBA)
				log("FDD: Write Command Received. Waiting for data...")
			end
		end
	end
	
	method void OnWritePort16(number port, number val)
		if port == 0x1F0 then
			local low = val & 0xFF
			local high = (val >> 8) & 0xFF
			table.insert(self.PortBuffer, string.format("%02X%02X", low, high))
			
			if #self.PortBuffer >= 256 then
				self.HDDImage[self.SelectedLBA] = table.concat(self.PortBuffer)
				log("FDD: PIO Sector Write Complete: " .. self.SelectedLBA)
				self.PortBuffer = {}
				self.SelectedLBA = self.SelectedLBA + 1
			end
		end
	end
	
	method number OnReadPort(number port)
		if port == 0x1F7 then 
			local status = 0x50
			if #self.PortBuffer > 0 and self.BufferIndex <= #self.PortBuffer then
				status = status | 0x08 
			end
			return status
		end
		return 0x00
	end
	
	method void PreparePortBuffer()
		if not self.IsReady then return end
		self:_ApplyHardwareAccess(self.SelectedLBA)
		self.PortBuffer = {}
		self.BufferIndex = 1
		for i = 0, self.SelectedSectorCount - 1 do
			local hexData = self.HDDImage[self.SelectedLBA + i]
			if hexData then
				for j = 1, #hexData, 4 do
					local low = tonumber(string.sub(hexData, j, j + 1), 16) or 0
					local high = tonumber(string.sub(hexData, j + 2, j + 3), 16) or 0
					table.insert(self.PortBuffer, (high << 8) | low)
				end
			end
		end
		log(string.format("FDD: PortBuffer Prepared. LBA: %d, Count: %d", self.SelectedLBA, self.SelectedSectorCount))
	end
	
	method number OnReadPort16(number port)
		if port == 0x1F0 then
			local val = self.PortBuffer[self.BufferIndex] or 0
			self.BufferIndex = self.BufferIndex + 1
			if self.BufferIndex > #self.PortBuffer then
				self.PortBuffer = {}
				self.BufferIndex = 1
			end
			return val
		end
		return 0x0000
	end
end